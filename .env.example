# =====================================================================
# CONTOH KONFIGURASI WEBSITE ALVERSE BOGOR KOTA
# Salin file ini menjadi ".env" lalu sesuaikan. File .env TIDAK masuk Git.
# Jangan menulis password asli di file .env.example.
# =====================================================================

# ---- Aplikasi ----
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8001

# ---- Identitas cabang (ID tetap dari panduan: bogor) ----
BRANCH_ID=bogor
BRANCH_NAME="Bogor Kota"
DEVELOPER_NAME=Hanif
# Informasi berikut BELUM ditetapkan kelompok -> wajib berlabel demo.
BRANCH_ADDRESS="Alamat demo, belum ditetapkan (bukan alamat toko nyata)"
BRANCH_PHONE="Kontak demo, belum ditetapkan"
PICKUP_HOURS="10.00–20.00 WIB (jam demo)"
PICKUP_LOCATION="Lokasi pickup simulasi Alverse Bogor Kota (alamat demo)"

# Nama cookie sesi. WAJIB beda dengan proyek lain yang berjalan di localhost.
SESSION_NAME=ALVERSE_BOGOR_SESS

# ---- Tarif simulasi (panduan v2) ----
SHIPPING_REGULER=10000
SHIPPING_PICKUP=0

# ---- Sumber data ----
# redis   = Redis lokal untuk latihan (dataset demo)
# central = layanan pusat Kelompok 6 (isi bagian CENTRAL_* dan config/central_endpoints.php)
DATA_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Kosongkan jika Redis lokal tanpa password/ACL.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2
# Database khusus tes otomatis (dikosongkan oleh tes). Harus berbeda dari REDIS_DB.
REDIS_TEST_DB=15

# ---- Layanan pusat Kelompok 6 (diisi setelah kontrak tersedia) ----
CENTRAL_BASE_URL=
CENTRAL_API_KEY=
CENTRAL_TIMEOUT=5

# ---- Admin cabang ----
ADMIN_USERNAME=admin_bogor
# Jangan isi manual. Jalankan: php scripts/set-admin-password.php
ADMIN_PASSWORD_HASH=

# ---- Preview lokal di dalam iframe (misalnya Mobile Preview) ----
# Bawaan false: website menolak dibingkai (X-Frame-Options DENY, frame-ancestors 'none').
# true HANYA berlaku jika APP_ENV=local. Yang berubah hanya aturan pembingkaian.
LOCAL_PREVIEW_FRAME=false
# Daftar asal yang boleh membingkai, dipisah spasi. Kosong = 'self' http://localhost:* http://127.0.0.1:* vscode-webview: chrome-extension:
# Nilai *, http:, https: ditolak (website kembali tidak bisa dibingkai).
LOCAL_PREVIEW_FRAME_ANCESTORS=

# ---- Tautan website cabang lain (isi setelah teman memberikan URL-nya) ----
BRANCH_URL_DRAMAGA=
BRANCH_URL_BANDUNG=
BRANCH_URL_DEPOK=
BRANCH_URL_JAKSEL=
BRANCH_URL_BEKASI=
BRANCH_URL_TANGERANG=
