# =====================================================================
# INSTANCE KEDUA KHUSUS PENGUJIAN LOKAL (BUKAN cabang resmi)
# Tujuan: membuktikan dua website membaca SATU stok global yang sama.
# Salin menjadi ".env.uji". Jalankan dengan APP_ENV_FILE=.env.uji (lihat README).
# Ini HANYA membuktikan integrasi lokal, belum membuktikan koneksi ke website teman.
# =====================================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8002

BRANCH_ID=uji
BRANCH_NAME="UJI LOKAL (bukan cabang resmi)"
DEVELOPER_NAME=Hanif
BRANCH_ADDRESS="Alamat demo instance uji"
BRANCH_PHONE="Kontak demo instance uji"
PICKUP_HOURS="Jam demo"
PICKUP_LOCATION="Lokasi pickup simulasi instance uji"

# Harus berbeda dari website Bogor agar sesi/keranjang tidak tertukar.
SESSION_NAME=ALVERSE_UJI_SESS

SHIPPING_REGULER=10000
SHIPPING_PICKUP=0

# SAMA dengan website Bogor -> membaca stok global yang sama.
DATA_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2
REDIS_TEST_DB=15

CENTRAL_BASE_URL=
CENTRAL_API_KEY=
CENTRAL_TIMEOUT=5

ADMIN_USERNAME=admin_uji
ADMIN_PASSWORD_HASH=
